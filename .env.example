# Palm Guard environment — copy to .env and fill in.
# Nothing here is required for `make data` / `make baseline` / `make test`.

# --- Backend (packages/api) ---
# Leave Supabase vars empty to use the in-memory DB fallback.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
API_HOST=0.0.0.0
API_PORT=8000

# Status engine debounce: how many consecutive confident infested hits flip a tree.
STATUS_INFESTED_STREAK=3
STATUS_CONFIDENCE_THRESHOLD=0.6

# --- Alerts (packages/api) ---
# Provider is one of: none | log | twilio | whatsapp
ALERT_PROVIDER=log
ALERT_RATE_LIMIT_MINUTES=60
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_TO=

# --- Edge (packages/edge) ---
EDGE_API_URL=http://localhost:8000
EDGE_DEVICE_ID=pi-zero-dev
EDGE_MODEL_PATH=../ml/artifacts/palmguard.tflite

# --- Web (packages/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- ML dataset (packages/ml) ---
# TreeVibes lives on Kaggle (not a plain download). Provide ONE of:
#   TREEVIBES_LOCAL  — path to an already-downloaded .zip OR an extracted folder.
#   TREEVIBES_KAGGLE — Kaggle slug, e.g. potamitis/treevibes (needs `pip install
#                      kaggle` + ~/.kaggle/kaggle.json or KAGGLE_USERNAME/KAGGLE_KEY).
#   TREEVIBES_URL    — direct archive URL (rare).
# All empty => synthetic smoke-test data.
TREEVIBES_LOCAL=
TREEVIBES_KAGGLE=
TREEVIBES_URL=
# Optional ESC-50 hard-negatives (non-insect classes -> clean):
ESC50_URL=
